# === LOCAL DEV ===
PORT=3000
MONGODB_URI=mongodb://localhost:27017/limdonut
JWT_SECRET=your_jwt_secret_here
ADMIN_PASSWORD=doi_mat_khau_nay_khi_deploy_that
CORS_ORIGINS=http://localhost:4200,http://localhost:4201,http://localhost:4321

# === KHI DEPLOY (điền trên Render, không dùng file .env) ===
# MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/limdonut
# JWT_SECRET=<chuoi_ngau_nhien_dai_va_bi_mat>
# CORS_ORIGINS=https://<ten-app>.vercel.app,https://<ten-admin>.vercel.app
# SMS gateway nhận POST JSON { to, code, purpose, expiresInSeconds }, Authorization: Bearer token.
# Không cấu hình SMS và không bật demo local thì hủy đơn qua tra cứu bị chặn.
SMS_OTP_URL=
SMS_OTP_TOKEN=

# Explicit opt-in: demo codes are returned only for direct localhost requests, never production.
CANCEL_OTP_DEMO=false

# Backend only: enable Google Geocoding API + Routes API and Billing.
# Restrict this key to those APIs; do not put it into Angular environment files.
GOOGLE_MAPS_API_KEY=
